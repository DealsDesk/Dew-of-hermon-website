# ---------------------------------------------------------------------------
# Static build (Hostinger shared hosting) — current setup
# ---------------------------------------------------------------------------
# Free access key from https://web3forms.com — enter the inbox that should
# receive enquiries and they email you the key. It is public by design: it only
# permits sending to the address that registered it, so it is safe in the
# bundled JavaScript.
#
# This must be set at BUILD time, not upload time — it gets compiled into the
# exported files. Without it the contact page shows phone/email links instead
# of a form.
NEXT_PUBLIC_WEB3FORMS_KEY=

# ---------------------------------------------------------------------------
# Node hosting only (Vercel / VPS) — see app/_node-only/contact-route.ts
# ---------------------------------------------------------------------------
# Unused by the static build. Needed only if the Resend handler is restored.
RESEND_API_KEY=
CONTACT_TO_EMAIL=dewofhermon225@gmail.com
CONTACT_FROM_EMAIL="Dew of Hermon <onboarding@resend.dev>"
